{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComplianceReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "system",
    "machineChecks",
    "agentReviews",
    "findings",
    "diffSummary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ui-design-system-compliance-report/v1"
    },
    "status": {
      "type": "string",
      "enum": ["review-required", "compliant", "repair-approved", "repair-complete"]
    },
    "system": {"$ref": "#/$defs/system"},
    "machineChecks": {
      "type": "array",
      "items": {"type": "object"}
    },
    "agentReviews": {
      "type": "array",
      "items": {"type": "object"}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "ruleId",
          "evidence",
          "reason",
          "recommendation",
          "confidence",
          "verificationStatus"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "ruleId": {"type": "string", "minLength": 1},
          "evidence": {},
          "reason": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "verificationStatus": {
            "type": "string",
            "enum": [
              "verified",
              "agent-judgment",
              "degraded-unverified",
              "user-approved-deviation"
            ]
          }
        }
      }
    },
    "diffSummary": {"type": "object"}
  },
  "$defs": {
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "assetVersion"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "assetVersion": {"type": "string", "minLength": 1}
      }
    }
  }
}
