{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConflictReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "system",
    "conflicts",
    "alternatives",
    "decisions",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ui-design-system-conflict-report/v1"
    },
    "system": {"$ref": "#/$defs/system"},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "rule", "risks"],
        "properties": {
          "requirement": {"type": "string", "minLength": 1},
          "rule": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "summary"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "summary": {"type": "string", "minLength": 1}
            }
          },
          "risks": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "visual": {"type": "string", "minLength": 1},
              "usability": {"type": "string", "minLength": 1},
              "brand": {"type": "string", "minLength": 1},
              "implementation": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "minItems": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["systemId", "reason"],
        "properties": {
          "systemId": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      },
      "minItems": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["switch-system", "keep-current-system", "adjust-requirements", "other"]
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "const": "awaiting-user-decision"
    }
  },
  "$defs": {
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "assetVersion"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "assetVersion": {"type": "string", "minLength": 1}
      }
    }
  }
}
