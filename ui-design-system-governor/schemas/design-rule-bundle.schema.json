{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesignRuleBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "system",
    "files",
    "tokens",
    "rules",
    "warnings",
    "approvedDeviations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ui-design-system-design-rule-bundle/v1"
    },
    "system": {"$ref": "#/$defs/system"},
    "files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "tokens": {
      "type": "array",
      "items": {"type": "object"}
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["enforcement"],
        "properties": {
          "enforcement": {
            "type": "string",
            "enum": ["machine-enforced", "agent-review", "explicit-prohibition", "preference"]
          }
        }
      }
    },
    "warnings": {"type": "array"},
    "approvedDeviations": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "$defs": {
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "assetVersion"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "assetVersion": {"type": "string", "minLength": 1}
      }
    }
  }
}
