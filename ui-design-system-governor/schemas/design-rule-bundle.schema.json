{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesignRuleBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "system",
    "files",
    "tokens",
    "rules",
    "warnings",
    "approvedDeviations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ui-design-system-design-rule-bundle/v1"
    },
    "system": {"$ref": "#/$defs/system"},
    "files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "tokens": {
      "type": "array",
      "items": {"type": "object"}
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "scope",
          "enforcement",
          "evidence",
          "source",
          "location",
          "confidence",
          "warnings"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "scope": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "enforcement": {
            "type": "string",
            "enum": ["machine-enforced", "agent-review", "explicit-prohibition", "preference"]
          },
          "evidence": {"type": "string", "minLength": 1},
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]\\.\\.(?:[\\\\/]|$)).+$"
          },
          "location": {"type": "object"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "warnings": {"type": "array"}
        }
      }
    },
    "warnings": {"type": "array"},
    "approvedDeviations": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "$defs": {
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "assetVersion"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "assetVersion": {"type": "string", "minLength": 1}
      }
    }
  }
}
